# Copy to k8s/secrets.yaml, fill in real values, then `kubectl apply -f k8s/secrets.yaml`.
# k8s/secrets.yaml is git-ignored - never commit real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: ollive-secrets
  namespace: ollive
type: Opaque
stringData:
  GEMINI_API_KEY: your-key-here
  POSTGRES_PASSWORD: choose-a-real-password
  DATABASE_URL: postgresql+asyncpg://ollive:choose-a-real-password@postgres:5432/ollive
